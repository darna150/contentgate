NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
OPENAI_API_KEY=your-server-only-openai-key
OPENAI_ASK_MODEL=gpt-5.6-sol
OPENAI_ASK_REASONING=medium
OPENAI_ASK_QUERY_MODEL=gpt-5.6-terra
OPENAI_ASK_TIMEOUT_MS=45000
# Optional stable salt for the privacy-preserving OpenAI safety identifier.
OPENAI_SAFETY_IDENTIFIER_SALT=replace-with-a-server-only-random-value
OPENAI_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-large
# Ask keeps a maximum of three retrieval intents per question. Retention is
# enforced through the explicit maintenance command, never automatically.
ASK_TELEMETRY_RETENTION_DAYS=90
OPENAI_GENERATION_MODEL=gpt-5.6-terra

# One-click onboarding control plane. All are server-only. The project ref must
# match NEXT_PUBLIC_SUPABASE_URL or every mutating run is blocked.
CONTENTGATE_ENVIRONMENT=development
CONTENTGATE_SUPABASE_PROJECT_REF=your-project
CONTENTGATE_PLATFORM_OPERATOR_EMAILS=operator@example.com
# Keep false in persistent configuration. Production runs additionally require
# the exact per-workspace confirmation shown by preflight.
CONTENTGATE_ALLOW_PRODUCTION_ONBOARDING=false
CONTENTGATE_APP_URL=http://127.0.0.1:3000

# Optional: live browser QA. Never commit real credentials.
CONTENTGATE_E2E_BASE_URL=https://contentgate-delta.vercel.app
CONTENTGATE_E2E_EMAIL=qa-user@example.com
CONTENTGATE_E2E_PASSWORD=qa-user-password
CONTENTGATE_E2E_ASSIGNMENT_ID=optional-platform-assignment-id
CONTENTGATE_E2E_PRODUCT_ID=provisioned-product-id
CONTENTGATE_E2E_PRODUCT_NAME=provisioned-product-name
CONTENTGATE_E2E_TEMPLATE_NAME=provisioned-template-family-name
CONTENTGATE_E2E_OUTPUT_SIZE_KEY=instagram-post-square
CONTENTGATE_E2E_OUTPUT_SIZE_LABEL=Instagram post (square)
CONTENTGATE_E2E_OUTPUT_WIDTH=1080
CONTENTGATE_E2E_OUTPUT_HEIGHT=1080
CONTENTGATE_E2E_KNOWLEDGE_QUESTION=What is the approved use of the configured product?
